# ============================================================
# Officerestore WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/officerestore_bot
MONGODB_DB_NAME=officerestore_bot

# --- MSG91 WhatsApp ---
# Required: Obtain from MSG91 dashboard
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX
MSG91_NAMESPACE=your_msg91_namespace_here
MSG91_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# MSG91 API base URL (default is correct for most accounts)
MSG91_API_BASE_URL=https://api.msg91.com/api/v5

# --- Catalogue / E-commerce Integration ---
# Set the catalogue provider: mock | woocommerce | shopify | custom
CATALOGUE_PROVIDER=mock

# WooCommerce (if CATALOGUE_PROVIDER=woocommerce)
WOOCOMMERCE_BASE_URL=https://yourstore.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxx

# Shopify (if CATALOGUE_PROVIDER=shopify)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# Custom catalogue API (if CATALOGUE_PROVIDER=custom)
CATALOGUE_API_BASE_URL=https://api.yourstore.com
CATALOGUE_API_KEY=your_api_key_here

# --- Order System ---
# Set provider: mock | custom
ORDER_PROVIDER=mock
ORDER_API_BASE_URL=https://orders.yourstore.com
ORDER_API_KEY=your_order_api_key_here

# --- CRM Integration ---
# Set provider: mock | custom
CRM_PROVIDER=mock
CRM_API_BASE_URL=https://crm.yoursystem.com
CRM_API_KEY=your_crm_api_key_here

# --- Security ---
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
WEBHOOK_RATE_LIMIT_MAX=120

# --- Admin Dashboard API Auth ---
ADMIN_API_KEY=change_this_admin_api_key

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Conversation Settings ---
# Seconds before an idle conversation times out
CONVERSATION_TIMEOUT_SECONDS=1800

# --- Support ---
SUPPORT_EMAIL=support@officerestore.com
SUPPORT_PHONE=+91XXXXXXXXXX
SUPPORT_HOURS=Mon-Sat 9AM-6PM IST
